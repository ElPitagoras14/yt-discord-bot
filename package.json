{
  "name": "yt-discord-bot",
  "version": "1.2.3",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "start:with-register": "node dist/deploy-command.js && pnpm start",
    "dev": "tsx --watch src/index.ts",
    "register": "tsx src/deploy-command.ts",
    "build": "tsc",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.7",
    "discord.js": "^14.24.0",
    "dotenv": "^17.2.3",
    "execa": "^9.6.1",
    "opusscript": "^0.0.8",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^24.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
